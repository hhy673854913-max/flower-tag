.confirm-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.swiper {
  flex: 1;
  height: 100vh;
}
.swiper-scroll {
  height: 100%;
}
.preview {
  width: 100%;
  height: 480rpx;
  background: #e9efe9;
}
.editor {
  padding: 0 24rpx;
}
.section-title .hint {
  font-size: 22rpx;
  color: #9aa39a;
  font-weight: 400;
  margin-left: 8rpx;
}
.flower-block {
  margin-bottom: 16rpx;
}
.flower-role {
  font-size: 26rpx;
  color: #6b736b;
  margin-bottom: 12rpx;
}
.flower-chip .del {
  margin-left: 10rpx;
  color: #c0392b;
  font-size: 24rpx;
}
.add-chip {
  border-style: dashed;
  color: #2e7d4f;
}
.action-row {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}
.action-row .act {
  flex: 1;
}
.save-all {
  margin-top: 24rpx;
}
.bottom-gap {
  height: 60rpx;
}
