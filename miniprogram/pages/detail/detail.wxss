.hero {
  width: 100%;
  height: 560rpx;
  background: #e9efe9;
  border-radius: 16rpx;
}
/* 查看原图按钮：跟随全局 btn-ghost 样式，仅补充布局 */
.orig-btn {
  margin: 16rpx auto 0;
  width: 220rpx;
  text-align: center;
  font-size: 26rpx;
}
.edit-tip {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  background: #fdf6e3;
  color: #b8860b;
  border-radius: 12rpx;
  font-size: 24rpx;
}
.flower-block {
  margin-bottom: 12rpx;
}
.flower-role {
  font-size: 26rpx;
  color: #6b736b;
  margin-bottom: 12rpx;
}
.chip .del {
  margin-left: 10rpx;
  color: #c0392b;
  font-size: 24rpx;
}
.add-chip {
  border-style: dashed;
  color: #2e7d4f;
}
.none-flower {
  font-size: 24rpx;
  color: #b9c0b9;
}
.action-row {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}
.action-row .act {
  flex: 1;
}
