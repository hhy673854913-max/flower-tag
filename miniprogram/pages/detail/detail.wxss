.hero-swiper {
  width: 100%;
  height: 560rpx;
  background: #e9efe9;
  border-radius: 16rpx;
  overflow: hidden;
}
.hero {
  width: 100%;
  height: 100%;
}
.hero-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 16rpx;
}
/* 查看原图按钮：跟随全局 btn-ghost 样式，仅补充布局 */
.orig-btn {
  margin: 0;
  width: 220rpx;
  text-align: center;
  font-size: 26rpx;
}
.edit-tip {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  background: #fdf6e3;
  color: #b8860b;
  border-radius: 12rpx;
  font-size: 24rpx;
}
.flower-block {
  margin-bottom: 12rpx;
}
.flower-role {
  font-size: 26rpx;
  color: #6b736b;
  margin-bottom: 12rpx;
}
.chip .del {
  margin-left: 10rpx;
  color: #c0392b;
  font-size: 24rpx;
}
.add-chip {
  border-style: dashed;
  color: #2e7d4f;
}
.none-flower {
  font-size: 24rpx;
  color: #b9c0b9;
}
.action-row {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}
.action-row .act {
  flex: 1;
}
.share-info { color: #648170; font-size: 26rpx; margin-bottom: 24rpx; }
.share-panel { margin-top: 24rpx; display: flex; gap: 24rpx; align-items: center; }
.share-panel > view, .share-button { flex: 1; text-align: center; }
.share-button { font-size: 28rpx; margin: 0; line-height: 1.6; }
.share-button::after { border: none; }
