<view class="readonly-nav" wx:if="{{shared}}">
  <view bindtap="goBack">返回</view>
  <view bindtap="goHome">进入花艺图库</view>
</view>
<view class="extras-progress" wx:if="{{extrasBusy}}">
  <view>{{extrasMessage}}</view>
  <view class="extras-actions">
    <view class="btn-ghost" wx:if="{{extrasUnknown}}" bindtap="checkExtraResult">核对保存结果</view>
    <view class="btn-ghost" bindtap="cancelExtras">取消附加图</view>
  </view>
</view>
<view class="page {{shared ? 'readonly-page' : ''}}" wx:if="{{record}}">
  <view class="share-info" wx:if="{{shared}}">{{authorName}}的花艺作品 · {{portfolio ? '作品集授权' : '单件分享'}} · 只读展示</view>
  <swiper class="hero-swiper" indicator-dots="{{true}}" circular="{{false}}" autoplay="{{false}}" bindchange="onSwiperChange">
    <!-- 主图 -->
    <swiper-item>
      <image wx:if="{{url && !imageErrors[0]}}" class="hero" src="{{url}}" mode="aspectFit" bindtap="previewOriginal" data-idx="0" data-url="{{url}}" binderror="onImageError" show-menu-by-longpress="{{false}}" />
      <view class="hero-image-error" wx:else bindtap="previewOriginal" data-idx="0">缩略图暂不可用 · 点此重试原图</view>
    </swiper-item>
    <!-- 附加图 -->
    <swiper-item wx:for="{{extraUrls}}" wx:key="index">
      <image wx:if="{{item && !imageErrors[index + 1]}}" class="hero" src="{{item}}" mode="aspectFit" bindtap="previewOriginal" data-idx="{{index + 1}}" data-url="{{item}}" binderror="onImageError" show-menu-by-longpress="{{false}}" />
      <view class="hero-image-error" wx:else bindtap="previewOriginal" data-idx="{{index + 1}}">缩略图暂不可用 · 点此重试原图</view>
    </swiper-item>
  </swiper>

  <view class="hero-actions">
    <view class="btn-ghost orig-btn" bindtap="previewOriginal" data-idx="{{currentSwiperIdx || 0}}">{{loadingOriginal ? '加载中…' : '查看原图'}}</view>
    <view class="btn-ghost orig-btn" bindtap="addExtraImages" wx:if="{{canManage && !editing && !extrasBusy && record && (!record.extraFiles || record.extraFiles.length < 8)}}">添加附加图</view>
  </view>

  <view class="edit-tip" wx:if="{{editing}}">编辑模式：点选修改标签，花材长按可调整角色</view>

  <!-- 通用维度（选中态由 JS 预算到 opt.on，WXML 不支持 indexOf） -->
  <block wx:for="{{dimView}}" wx:for-item="dim" wx:for-index="dimIdx" wx:key="key">
    <view class="section-title" wx:if="{{canManage || dim.options.length}}">{{dim.name}}</view>
    <view class="chip-wrap">
      <view
        wx:for="{{dim.options}}"
        wx:for-item="opt"
        wx:for-index="optIdx"
        wx:key="name"
        wx:if="{{canManage || opt.on}}"
        class="chip {{opt.on ? 'on' : ''}}"
        data-key="{{dim.key}}"
        data-value="{{opt.name}}"
        data-multi="{{dim.multi}}"
        bindtap="toggleTag"
      >{{opt.name}}</view>
    </view>
  </block>

  <!-- 花材 -->
  <view class="section-title">花材</view>
  <view class="flower-block" wx:for="{{roles}}" wx:for-item="role" wx:key="key">
    <view class="flower-role">{{role.name}}</view>
    <view class="chip-wrap">
      <block wx:for="{{record[role.key]}}" wx:for-item="fname" wx:key="*this">
        <view wx:if="{{canManage}}" class="chip" data-role="{{role.key}}" data-index="{{index}}" bindlongpress="moveFlower">{{fname}}<text wx:if="{{editing}}" class="del" data-role="{{role.key}}" data-index="{{index}}" catchtap="removeFlower">✕</text></view>
        <view class="chip" wx:else>{{fname}}</view>
      </block>
      <view wx:if="{{editing}}" class="chip add-chip" data-role="{{role.key}}" bindtap="addFlower">＋ 添加</view>
    </view>
    <view class="none-flower" wx:if="{{!record[role.key] || !record[role.key].length}}">无</view>
  </view>

  <view class="action-row" wx:if="{{canManage && !editing && !extrasBusy}}">
    <view class="btn-ghost act" bindtap="toggleEdit">编辑标签</view>
    <view class="btn-danger act" bindtap="remove">删除</view>
  </view>
  <view class="action-row" wx:elif="{{canManage && editing}}">
    <view class="btn-ghost act" bindtap="toggleEdit">取消</view>
    <view class="btn-primary act {{saving ? 'disabled' : ''}}" bindtap="save">保存修改</view>
  </view>
  <view class="share-panel" wx:if="{{canManage && !editing && !extrasBusy}}">
    <view class="btn-ghost" bindtap="setSharing">{{shareBusy ? '处理中…' : shareToken ? '停止单件分享' : '开启单件分享'}}</view>
    <button class="btn-primary share-button" wx:if="{{shareToken}}" open-type="share">分享给好友</button>
  </view>
</view>
<view class="page empty" wx:elif="{{loadError}}">
  <view>{{loadError}}</view>
  <view class="detail-retry" bindtap="loadRecord">重新读取</view>
</view>
<view class="page empty" wx:else>正在读取作品…</view>
