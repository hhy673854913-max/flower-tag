<view class="page" wx:if="{{record}}">
  <view class="share-info" wx:if="{{shared}}">{{authorName}}的花艺作品 · 只读展示</view>
  <swiper class="hero-swiper" indicator-dots="{{true}}" circular="{{false}}" autoplay="{{false}}" bindchange="onSwiperChange">
    <!-- 主图 -->
    <swiper-item>
      <image class="hero" src="{{url}}" mode="aspectFit" bindtap="previewOriginal" data-idx="0" />
    </swiper-item>
    <!-- 附加图 -->
    <swiper-item wx:for="{{extraUrls}}" wx:key="index">
      <image class="hero" src="{{item}}" mode="aspectFit" bindtap="previewOriginal" data-idx="{{index + 1}}" />
    </swiper-item>
  </swiper>

  <view class="hero-actions">
    <view class="btn-ghost orig-btn" bindtap="previewOriginal" data-idx="{{currentSwiperIdx || 0}}">{{loadingOriginal ? '加载中…' : '查看原图'}}</view>
    <view class="btn-ghost orig-btn" bindtap="addExtraImages" wx:if="{{canManage && !editing && record && (!record.extraFiles || record.extraFiles.length < 8)}}">添加附加图</view>
  </view>

  <view class="edit-tip" wx:if="{{editing}}">编辑模式：点选修改标签，花材长按可调整角色</view>

  <!-- 通用维度（选中态由 JS 预算到 opt.on，WXML 不支持 indexOf） -->
  <block wx:for="{{dimView}}" wx:for-item="dim" wx:for-index="dimIdx" wx:key="key">
    <view class="section-title">{{dim.name}}</view>
    <view class="chip-wrap">
      <view
        wx:for="{{dim.options}}"
        wx:for-item="opt"
        wx:for-index="optIdx"
        wx:key="name"
        class="chip {{opt.on ? 'on' : ''}}"
        data-key="{{dim.key}}"
        data-value="{{opt.name}}"
        data-multi="{{dim.multi}}"
        bindtap="toggleTag"
      >{{opt.name}}</view>
    </view>
  </block>

  <!-- 花材 -->
  <view class="section-title">花材</view>
  <view class="flower-block" wx:for="{{roles}}" wx:for-item="role" wx:key="key">
    <view class="flower-role">{{role.name}}</view>
    <view class="chip-wrap">
      <view
        class="chip"
        wx:for="{{record[role.key]}}"
        wx:for-item="fname"
        wx:key="*this"
        data-role="{{role.key}}"
        data-index="{{index}}"
        bindlongpress="moveFlower"
      >{{fname}}<text wx:if="{{editing}}" class="del" data-role="{{role.key}}" data-index="{{index}}" catchtap="removeFlower">✕</text></view>
      <view wx:if="{{editing}}" class="chip add-chip" data-role="{{role.key}}" bindtap="addFlower">＋ 添加</view>
    </view>
    <view class="none-flower" wx:if="{{!record[role.key].length}}">无</view>
  </view>

  <view class="action-row" wx:if="{{canManage && !editing}}">
    <view class="btn-ghost act" bindtap="toggleEdit">编辑标签</view>
    <view class="btn-danger act" bindtap="remove">删除</view>
  </view>
  <view class="action-row" wx:elif="{{canManage && editing}}">
    <view class="btn-ghost act" bindtap="toggleEdit">取消</view>
    <view class="btn-primary act {{saving ? 'disabled' : ''}}" bindtap="save">保存修改</view>
  </view>
  <view class="share-panel" wx:if="{{canManage && !editing}}">
    <view class="btn-ghost" bindtap="setSharing">{{shareBusy ? '处理中…' : shareToken ? '停止作品分享' : '开启作品分享'}}</view>
    <button class="btn-primary share-button" wx:if="{{shareToken}}" open-type="share">分享给好友</button>
  </view>
</view>
<view class="page empty" wx:elif="{{loadError}}">{{loadError}}</view>
<view class="page empty" wx:else>正在读取作品…</view>
