<view class="page page-tab">
  <view class="stat-card">
    <view class="stat-main">
      <view class="stat-num">{{total}}</view>
      <view class="stat-label">作品记录</view>
    </view>
    <view class="stat-grid">
      <view class="stat-item"><view class="v">{{topColor}}</view><view class="k">常用颜色</view></view>
      <view class="stat-item"><view class="v">{{topFlower}}</view><view class="k">常用花材</view></view>
      <view class="stat-item"><view class="v">{{topStyle}}</view><view class="k">常用风格</view></view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goTags">
      <text>标签管理</text><text class="arrow">›</text>
    </view>
    <view class="menu-item">
      <view class="menu-left">
        <view>原图无损上传</view>
        <view class="menu-sub">关闭后上传前将高画质压缩（有损）</view>
      </view>
      <switch checked="{{lossless}}" color="#2e7d4f" bindchange="toggleLossless" />
    </view>
    <view class="menu-item" bindtap="about">
      <text>关于与隐私说明</text><text class="arrow">›</text>
    </view>
    <view class="menu-item danger" bindtap="clearAll">
      <text>清空全部数据</text><text class="arrow">›</text>
    </view>
  </view>
</view>
