.page-heading { padding: 20rpx 4rpx 42rpx; }
.eyebrow, .access-index {
  color: #648170;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}
.page-title { color: #24362c; font-size: 48rpx; font-weight: 600; margin-top: 12rpx; }
.page-intro { color: #7b887d; font-size: 26rpx; margin-top: 10rpx; }
.access-panel, .upload-card {
  background: #fffdf9;
  border: 1rpx solid #e6e9df;
  border-radius: 24rpx;
  padding: 38rpx 34rpx;
}
.access-title, .upload-title { color: #24362c; font-size: 36rpx; font-weight: 600; margin-top: 20rpx; }
.access-copy, .upload-desc { color: #69776c; font-size: 26rpx; line-height: 1.7; margin-top: 16rpx; }
.open-action { display: block; margin-top: 42rpx; }
.text-action { color: #377454; font-size: 28rpx; margin-top: 30rpx; }
.pick-row { margin-top: 46rpx; }
.pick-btn { margin-bottom: 20rpx; }
.pick-btn:last-child { margin-bottom: 0; }
.tip-card { margin-top: 26rpx; padding: 16rpx 6rpx; }
.tip-title { color: #4a6953; font-weight: 600; font-size: 24rpx; }
.tip-text { color: #8a978b; font-size: 23rpx; line-height: 1.6; margin-top: 8rpx; }

.progress-summary {
  margin: 12rpx 0 28rpx;
  color: #6b736b;
  font-size: 26rpx;
}
.progress-summary .clear {
  float: right;
  color: #c0392b;
}

.item {
  display: flex;
  background: #fffdf9;
  border: 1rpx solid #e6e9df;
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
  align-items: center;
}
.item-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  background: #e9efe9;
  flex-shrink: 0;
}
.item-info {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}
.item-status {
  font-size: 28rpx;
}
.s-done { color: #2e7d4f; }
.s-error { color: #c0392b; font-size: 24rpx; }
.s-uploading, .s-compressing, .s-thumbnail, .s-checking, .s-analyzing { color: #4a6953; }
.status-spinner {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  margin-right: 12rpx;
  border: 3rpx solid #dce5dc;
  border-top-color: #4a6953;
  border-radius: 50%;
  vertical-align: -2rpx;
  animation: status-turn 1s linear infinite;
}
@keyframes status-turn { to { transform: rotate(360deg); } }
.stage-meta { color: #7b887d; font-size: 21rpx; margin-top: 12rpx; }
.stage-hint { color: #69776c; font-size: 22rpx; line-height: 1.6; margin-top: 10rpx; }
.upload-track { height: 6rpx; background: #e9efe9; border-radius: 6rpx; margin-top: 14rpx; overflow: hidden; }
.upload-fill { height: 100%; background: #648170; border-radius: 6rpx; transition: width .2s ease; }
.item-tags {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b736b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.retry {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 28rpx;
  border: 2rpx solid #c0392b;
  color: #c0392b;
  border-radius: 28rpx;
  font-size: 24rpx;
}
