.portfolio-page { padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); min-height: 100vh; box-sizing: border-box; }
.top-line { display: flex; justify-content: space-between; margin-bottom: 44rpx; }
.text-link { color: #648170; font-size: 25rpx; padding: 12rpx 0; }
.portfolio-heading { margin: 0 4rpx 32rpx; }
.eyebrow { color: #648170; font-size: 23rpx; letter-spacing: 2rpx; margin-bottom: 16rpx; }
.portfolio-title { font-size: 42rpx; line-height: 1.45; font-weight: 600; color: #27392c; overflow-wrap: break-word; word-break: break-all; }
.author { margin-top: 18rpx; font-size: 25rpx; line-height: 1.7; color: #648170; overflow-wrap: break-word; word-break: break-all; }
.portfolio-description { display: block; margin-top: 24rpx; padding-left: 22rpx; border-left: 3rpx solid #c7d8c9; font-size: 28rpx; line-height: 1.85; color: #3e5446; white-space: pre-wrap; overflow-wrap: break-word; word-break: break-all; }
.heading-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; gap: 20rpx; }
.count { color: #899589; font-size: 25rpx; line-height: 1.7; }
.share-action { flex-shrink: 0; margin: 0; padding: 10rpx 22rpx; border-radius: 28rpx; line-height: 1.7; font-size: 24rpx; color: #2d6543; background: #e3eee5; }
.share-action::after { border: none; }
.works-grid { display: flex; flex-wrap: wrap; gap: 20rpx; align-items: stretch; }
.work-card { width: calc((100% - 20rpx) / 2); overflow: hidden; border-radius: 20rpx; background: #fffdf9; padding-bottom: 18rpx; }
.work-card.unconfirmed { opacity: 0.65; }
.work-image, .image-state { display: block; width: 100%; height: 390rpx; background: #e9efe9; }
.image-state { display: flex; align-items: center; justify-content: center; color: #8b988b; font-size: 24rpx; }
.work-caption { padding: 18rpx 18rpx 0; color: #3e5446; font-size: 25rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.work-colors { margin: 8rpx 18rpx 0; font-size: 22rpx; line-height: 1.6; color: #899589; }
.state-panel { padding: 100rpx 24rpx; text-align: center; }
.state-title { font-size: 32rpx; color: #3e5446; margin-bottom: 18rpx; }
.state-note { color: #899589; font-size: 26rpx; line-height: 1.8; }
.retry { color: #2d6543; padding: 24rpx 12rpx; }
.status-banner { text-align: center; padding: 20rpx 12rpx; margin-bottom: 24rpx; border-radius: 16rpx; background: #e9efe9; font-size: 24rpx; color: #648170; }
.list-footer { text-align: center; color: #899589; font-size: 24rpx; padding-top: 30rpx; }
.readonly-note { text-align: center; color: #9aa39a; font-size: 22rpx; margin-top: 32rpx; }
