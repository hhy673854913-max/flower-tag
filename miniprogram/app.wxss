/* 全局样式 */
page {
  background: #f6f8f6;
  font-size: 28rpx;
  color: #2b2f2b;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

/* 主按钮 */
.btn-primary {
  background: #2e7d4f;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 22rpx 0;
  text-align: center;
}
.btn-primary.disabled {
  background: #b9cfc2;
}
.btn-ghost {
  border: 2rpx solid #2e7d4f;
  color: #2e7d4f;
  background: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-danger {
  background: #fff;
  color: #c0392b;
  border: 2rpx solid #e5b8b2;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 32rpx 0 16rpx;
  display: flex;
  align-items: center;
}
.section-title .warn {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #d48806;
  font-weight: 400;
}

/* 标签 chips */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 2rpx solid #d9e2da;
  font-size: 26rpx;
  color: #4a524a;
}
.chip.on {
  background: #e3f1e8;
  border-color: #2e7d4f;
  color: #2e7d4f;
  font-weight: 600;
}
.chip .cnt {
  font-size: 22rpx;
  color: #9aa39a;
  margin-left: 6rpx;
}
.chip.on .cnt {
  color: #2e7d4f;
}

/* 图片网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.grid .cell {
  width: calc((100% - 32rpx) / 3);
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}
.grid .thumb {
  width: 100%;
  height: 226rpx;
  display: block;
  background: #e9efe9;
}
.grid .cell-tags {
  padding: 10rpx 14rpx;
  font-size: 22rpx;
  color: #6b736b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.empty {
  text-align: center;
  color: #9aa39a;
  padding: 120rpx 40rpx;
  font-size: 26rpx;
  line-height: 1.8;
}
.empty .empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}
